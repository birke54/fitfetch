# Copy to .env and adjust. docker-compose reads this file automatically.
DB_NAME=fitfetch
POSTGRES_SUPER_USER=<change-me>
POSTGRES_SUPER_PASSWORD=<change-me>

APP_POSTGRES_USER=<change-me>
APP_POSTGRES_PASSWORD=<change-me>

# Host port to publish Postgres on (container port is always 5432)
DB_HOST=<change-me>
DB_PORT=5432

# API Key used to perform geocoding API calls
GOOGLE_GEO_API_KEY=<change-me>

# Ollama: one base URL, and a model per pass. OLLAMA_NORMALIZE_MODEL defaults
# to OLLAMA_MODEL. Set APP_NORMALIZE_LLM_THINK=false for a thinking model
# (Qwen3); leave it unset for any other, which Ollama requires.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
#OLLAMA_NORMALIZE_MODEL=qwen3:8b
#OLLAMA_EMBED_MODEL=nomic-embed-text
#APP_NORMALIZE_LLM_THINK=false

# Each pass: whether it runs, how often, and how much it takes per run.
# Every pass is off unless its variable says otherwise; the values shown are
# the defaults. A working deployment sets at least FETCH_ENABLE and
# LOCATION_ENABLE to true.
FETCH_CRON_SCHEDULE=0 0 3 * * *
FETCH_ENABLE=true

LOCATION_ENABLE=true
#LOCATION_SCHEDULE=0 */5 * * * *
LOCATION_PAGE_SIZE=300
#LOCATION_WARM_CACHES_ONLY=false

#NORMALIZE_ENABLE=false
#NORMALIZE_SCHEDULE=0 */10 * * * *
#NORMALIZE_PAGE_SIZE=2

# Needs the embedding model pulled: ollama pull nomic-embed-text
#EMBEDDING_ENABLE=false
#EMBEDDING_SCHEDULE=0 */10 * * * *
#EMBEDDING_PAGE_SIZE=20
#EMBEDDING_BATCH_SIZE=32

# Needs a profile.yaml and the embedding pass
#MATCH_ENABLE=false
#MATCH_SCHEDULE=0 */10 * * * *
#MATCH_PAGE_SIZE=100
